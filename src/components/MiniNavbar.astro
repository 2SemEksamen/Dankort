---
const { active } = Astro.props;
---

<section class="tabs-wrapper">
  <nav class="tabs">
    
    <a 
      href="/velkommen" 
      class={`tab ${active === "velkommen" ? "active" : ""}`}
    >
      Velkommen
    </a>

    <a 
      href="/fordele" 
      class={`tab ${active === "fordele" ? "active" : ""}`}
    >
      Fordele
    </a>

    <a 
      href="/oere" 
      class={`tab ${active === "oere" ? "active" : ""}`}
    >
      Øremærket
    </a>

  </nav>
</section>

<style>
  * {
    box-sizing: border-box;
  }

  .tabs-wrapper {
    position: fixed;
    bottom: 0;
    left: 0;

    width: 100%;

    background: #f5f5f5;

    display: flex;
    justify-content: center;

    padding: 16px;

    z-index: 1000;
  }

  .tabs {
    width: 100%;
    max-width: 700px;

    display: flex;
    justify-content: center;
    gap: 80px;

    border-bottom: 2px solid #d9d9d9;
  }

  .tab {
    position: relative;

    text-decoration: none;
    color: #111;
    padding-bottom: 14px;
    white-space: nowrap;
  }

  .tab.active::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -2px;

    width: 100%;
    height: 3px;

    background: #e31b23;
  }

 @media (min-width: 768px) {
  .tabs-wrapper {
    position: relative;

    padding-top: 48px;
    padding-bottom: 40px;

    background: white;
  }

  .tabs {
    max-width: 560px;
    gap: 145px;
  }

  .tab {



    padding-bottom: 18px;
  }

  .tab.active::after {
    height: 4px;
  }
}

</style>