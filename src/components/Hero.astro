---
// Hero.astro - selvstændig, ingen global.css nødvendig
export interface Props {
  title?: string;
  highlight?: string;
  description?: string;
  linkText?: string;
  linkHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}
 
const {
  title = "Hver gang du betaler,",
  highlight = "gør du en forskel",
  description = "Med Dankort Øremærket støtter du naturen i Danmark — helt automatisk, hver gang du betaler med dit Dankort eller Visa/Dankort.",
  linkText = "Læs mere om Den Danske Naturfond",
  linkHref = "#",
  imageSrc = "/images/card-plant.png",
  imageAlt = "Dankort kort med plante"
} = Astro.props;
---
 
<section class="hero">
  <div class="hero__container">
    <h1 class="hero__title">
      {title}<br />
      <span class="hero__highlight">{highlight}</span>
    </h1>
 
    <p class="hero__description">{description}</p>
    <a href={linkHref} class="hero__link">{linkText}</a>
 
    <div class="hero__image">
      <img src={imageSrc} alt={imageAlt} />
    </div>
  </div>
</section>
 
<style>
  @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap');
 
  /* Mobile-first */
  .hero {
    padding: 1.25rem 0 2rem;
    background: #FFFFFF;
    font-family: 'Raleway', -apple-system, sans-serif;
    color: #1A1A1A;
  }
 
  .hero__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
 
  .hero__title {
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }
 
  .hero__highlight {
    color: #E21E26;
  }
 
  .hero__description {
    color: #1A1A1A;
    font-size: 0.95rem;
    max-width: 38ch;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }
 
  .hero__link {
    color: #E21E26;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
 
  .hero__link:hover {
    color: #E21E26;
  }
 
  .hero__image {
    margin-top: 2rem;
  }
 
  .hero__image img {
    width: 100%;
    height: auto;
    object-fit: contain;
    max-width: 280px;
    margin: 0 auto;
    display: block;
  }
 
  /* Tablet og opefter */
  @media (min-width: 768px) {
    .hero {
      padding: 4rem 0 2.5rem;
    }
 
    .hero__container {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
      align-items: center;
      padding: 0 1.5rem;
    }
 
    .hero__title {
      grid-column: 1;
      font-size: 2.25rem;
      margin-bottom: 1.5rem;
    }
 
    .hero__description {
      grid-column: 1;
    }
 
    .hero__link {
      grid-column: 1;
    }
 
    .hero__image {
      grid-column: 2;
      grid-row: 1 / span 3;
      margin-top: 0;
    }
  }
 
  @media (min-width: 1024px) {
    .hero__title {
      font-size: 2.5rem;
    }
  }
</style>
 