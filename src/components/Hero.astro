---
const {
  title = "Hver gang du betaler,",
  highlight = "gør du en forskel",
  description = "Med Dankort Øremærket støtter du naturen i Danmark — helt automatisk, hver gang du betaler med dit Dankort eller Visa/Dankort.",
  linkText = "Læs mere om Den Danske Naturfond",
  linkHref = "https://naturfonden.dk/?gad_source=1&gad_campaignid=22207585853&gbraid=0AAAAAC8Dva9a1v0yxxFjhJtSrX1SS9j5p&gclid=CjwKCAjw5s_QBhAdEiwADD_gBo_y8uLhC8JL41dDY8sfqBLep1R3-wccMpOg6tSkO9qBSgAjgeUQXhoCKGYQAvD_BwE",
  imageSrc = "/images/dankortgren.webp",
  imageAlt = "Dankort kort med plante"
} = Astro.props;
---
 
<section class="hero">
  <div class="hero__container">
    <h1 class="hero__title">
      {title}<br />
      <span class="hero__highlight">{highlight}</span>
    </h1>
 
    <p class="hero__description">{description}</p>
    <a href={linkHref} class="hero__link">{linkText}</a>
 
    <div class="hero__image">
      <img src={imageSrc} alt={imageAlt} />
    </div>
  </div>
</section>
 
<style>

  .hero {
  padding: 1.25rem 0 2rem;
  background: #FFFFFF;
  font-family: 'Raleway', sans-serif;
  color: #1A1A1A;
  position: relative;  
  z-index: 2;           
}

.hero__image {
  margin-top: 2rem;
  margin-bottom: -4rem;  
  position: relative;   
  z-index: 2;            
}
  .hero {
    padding: 1.25rem 0 2rem;
    background: #FFFFFF;
    font-family: 'Raleway', sans-serif;
    color: #1A1A1A;
  }
 
  .hero__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
 
  .hero__title {
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: lighter;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
;
  }
 
  .hero__highlight {
    color: #E21E26;
    font-weight: 800;
  }
 
  .hero__description {
    color: #1A1A1A;
    font-size: 0.95rem;
    max-width: 38ch;
    margin-bottom: 1.25rem;
    line-height: 1.5;
    font-weight: lighter;
  }
 
  .hero__link {
    color: #E21E26;
    font-weight: 700;
    font-size: 0.875rem;
  }
 
 
  .hero__image {
    margin-top: 2rem;
  }
 
  .hero__image img {
    width: 100%;
    height: auto;
    object-fit: contain;
    margin: 0 auto;
    display: block;
  }
 
  @media (min-width: 768px) {
    .hero {
      padding: 4rem 0 2.5rem;
    }
 
    .hero__container {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
      align-items: center;
      padding: 0 1.5rem;
    }
 
    .hero__title {
      grid-column: 1;
      font-size: 2.25rem;
      margin-bottom: 1.5rem;
    }
 
    .hero__description {
      grid-column: 1;
    }
 
    .hero__link {
      grid-column: 1;
    }
 .hero__image {
  grid-column: 2;
  grid-row: 1 / span 3;
  margin-top: 0;
  margin-bottom: -21.5rem;
}
  }
 
  @media (min-width: 1024px) {
    .hero__title {
      font-size: 2.5rem;
    }
  }
</style>
 