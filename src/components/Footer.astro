<style>
  .menu-wrapper {
    padding: 32px;
    background: #f3f3f3;
    min-height: 100vh;
    width: 100%;
    font-family: "Raleway", sans-serif;
     box-sizing: border-box;

  }

  .menu-card {
    background: #e9e9e9;
    border-radius: 40px;
    padding: 28px;
    height: 670px;
  }

  .language-box {
    width: fit-content;
    background: white;
    border-radius: 999px;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 50px;
    max-height: 40px;
  }
.dropdown {
    font-size: 30px;
    color: #333;
    margin-top: 15px;
  }
  .flag {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #E21E28;
    position: relative;
    overflow: hidden;
  }


  .language-box span {
    font-size: 20px;
  
    font-weight: bolder;
    color: #243040;
  }

  .menu-section {
    margin-bottom: 55px;
  }

  .menu-section h2 {
    font-size: 16px;
    font-weight: extra-bold;
    color: #243040;
   
  }
.menu-section a {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: #333;
  font-size: 16px;

}

.menu-section a::before {
  content: "›";
  color: #E31C23;
  font-size: 34px;
  font-weight: bold;
  line-height: 1;
}



  .campaign-card {
    margin-top: 28px;
    background: #E21E28;
    border-radius: 40px;
    padding: 40px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .campaign-card img {
    width: 90px;
    margin-bottom: 20px;
  }

  .campaign-card h1 {
    color: white;
    font-size: 35px;
    line-height: 1.1;
    font-weight: extra-bold;
  }
  .arrow {

  font-size: 40px;
  color: #E31C23;
  font-weight: bold;

}

.arrowText {
  display: flex;
  align-items: center;
  gap: 8px;
}

@media (min-width: 1024px) {
  .menu-wrapper {
    display: flex;
    gap: 28px;

  }

  .menu-card {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 70px;
    position: relative;
        max-height: 340px;
  }

  .language-box {
    width: 220px;
    margin-bottom: 80px;
    margin-right: 50px;
  }

  .menu-section {
    flex: 1;
    min-width: 250px;
    margin-bottom: 0;
    
  }

  .campaign-card {
    width: 420px;
    margin-top: 0;
    max-height: 400px;
   
  }

  .campaign-card h1 {
    font-size: 50px;
  }
 .campaign-card img {
    width: 150px;
    margin-bottom: 20px;
  }}