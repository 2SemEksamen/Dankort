---
const {
  category = "OM DANSKE BUTIKKER",
  title = "Du støtter lokale butikker og lader pengene blive i Danmark",
  description = "Når du betaler med dit Dankort, undgår butikkerne dyre kortgebyrer — penge der i stedet kan bruges på at skabe værdi lokalt. Du er med til at styrke danske butikker og lokalsamfund, og sørger for at gebyret bliver i Danmark og skaber værdi, hvor du bor.",
  linkText = "Læs mere om hvordan det virker",
  linkHref = "#",
  imageSrc = "/images/gladevennersammen.webp",
  imageAlt = "Glade venner sammen"
} = Astro.props;
---

<section class="local-support">
  <div class="local-support__container">
    <div class="local-support__text">
      <span class="local-support__category">{category}</span>
      <h2 class="local-support__title">{title}</h2>
      <p class="local-support__description">{description}</p>
      <a href={linkHref} class="local-support__link">{linkText}</a>
    </div>
    <div class="local-support__image">
      <img src={imageSrc} alt={imageAlt} />
    </div>
  </div>
</section>

<style>
  .local-support {
    padding: 2rem 0;
    font-family: 'Raleway', sans-serif;
    color: #1A1A1A;
  }

  .local-support__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .local-support__category {
    display: block;
    font-size: 0.7rem;
    font-weight: bolder;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E21E26;
    margin-bottom: 0.875rem;
  }

  .local-support__title {
    font-size: 1.35rem;
    font-weight: bolder;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 0.875rem;
  }

  .local-support__description {
    color: #1A1A1A;
    font-size: 0.9rem;
    margin-bottom: 0.875rem;
    line-height: 1.6;
    font-family: 'Raleway', sans-serif;
    font-weight: lighter
  }

  .local-support__link {
    color: #E21E26;
    font-weight: bolder;
    font-size: 0.875rem;
    
  }

  .local-support__link:hover {
    color: #E21E26;
  }

  .local-support__image img {
   width: 100%; 
   max-width: 673px;
    border-radius: 55px;
    object-fit: cover;
  margin: 0 auto;
  }

  @media (min-width: 768px) {
    .local-support {
      padding: 4rem 0;
    }

    .local-support__container {
      padding: 0 1.5rem;
      gap: 2.5rem;
    }

    .local-support__title {
      font-size: 1.75rem;
      max-width: 22ch;
    }

    .local-support__description {
      font-size: 0.95rem;
      max-width: 56ch;
    }

    .local-support__image img {
      aspect-ratio: 16 / 7;
    }
  }

  @media (min-width: 1024px) {
    .local-support__title {
      font-size: 1.9rem;
    }
  }
</style>