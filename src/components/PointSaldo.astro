---
const { point = 0 } = Astro.props;
---

<aside class="point-saldo">
  <p>Din saldo</p>
  <strong>{point}</strong>
  <span>POINT</span>
</aside>

<style>
  .point-saldo {
    text-align: center;
    margin-top: 48px;
  }

  .point-saldo p {
    font-size: 28px;
    margin: 0 0 16px;
  }

  .point-saldo strong {
    display: block;
    color: #E21E27;
    font-size: 64px;
    line-height: 1;
    font-weight: 800;
  }

  .point-saldo span {
    display: block;
    font-size: 28px;
    font-weight: 800;
    margin-top: 12px;
  }

  @media (min-width: 768px) {
    .point-saldo {
      margin-top: 0;
    }
  }
</style>