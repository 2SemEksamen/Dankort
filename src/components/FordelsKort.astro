---
const { fordel } = Astro.props;
---

<article class="fordels-kort">

  <img src={fordel.Image} alt={fordel["Front-title"]} />

  <h3>{fordel["Front-title"]}</h3>

  <p>{fordel.Points} point</p>

</article>

<style>
.fordels-kort {
  width: 140px;
}

  img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 16px;
  }

  h3 {
    font-size: 12px;
    margin: 8px 0 2px;
  }

  p {
    font-size: 11px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .fordels-kort {
      width: 180px;
    }

    img {
      width: 180px;
      height: 180px;
    }

    h3 {
      font-size: 14px;
    }

    p {
      font-size: 12px;
    }
  }
</style>